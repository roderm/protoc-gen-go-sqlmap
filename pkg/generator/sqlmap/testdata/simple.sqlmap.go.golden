package simplepb

import (
	context "context"
	fmt "fmt"
	v1 "github.com/roderm/protoc-gen-go-sqlmap/pkg/generated/schema/v1"
	query "github.com/roderm/protoc-gen-go-sqlmap/pkg/query"
	proto "google.golang.org/protobuf/proto"
	fieldmaskpb "google.golang.org/protobuf/types/known/fieldmaskpb"
)

var (
	SimpleColumnDef_Id = &v1.SchemaColumn{
		Name: proto.String("simple_id"),
		Type: map[string]string{
			"mysql":    "BIGINT",
			"postgres": "BIGINT",
			"sqlite3":  "INTEGER",
		},
		Pk:       v1.PK_PK_AUTO.Enum(),
		Nullable: proto.Bool(false),
	}
	SimpleColumnDef_Name = &v1.SchemaColumn{
		Name: proto.String("simple_name"),
		Type: map[string]string{
			"mysql":    "VARCHAR(255)",
			"postgres": "VARCHAR(255)",
			"sqlite3":  "VARCHAR(255)",
		},
		Pk:       v1.PK_PK_UNSPECIFIED.Enum(),
		Nullable: proto.Bool(true),
	}
)
var SimpleTable = &v1.SchemaTable{
	Name: proto.String("tbl_simple"),
	Columns: []*v1.SchemaColumn{
		SimpleColumnDef_Id,
		SimpleColumnDef_Name,
	},
}

func init() {
}

type SimpleResult struct {
	Simple
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *SimpleResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "simple_id":
			values[i] = &n.Id
		case "simple_name":
			values[i] = &n.Name
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	return nil
}

func (n *Simple) GetColValue(col string) any {
	switch col {
	case "simple_id":
		return n.Id
	case "simple_name":
		return n.Name
	default:
		return nil
	}
}

func GetSimplePKColumns() []string {
	return []string{
		"simple_id",
	}
}

func GetSimpleColumns() []string {
	return []string{
		"simple_id",
		"simple_name",
	}
}

// SimpleQueryColumns returns the columns to select for mask. Primary keys
// are always included: they are what relations are stitched on, so leaving
// them out of the mask must not break eager loading.
func SimpleQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 2+len(extra))
	cols = append(cols, "simple_id")
	if m.Has("name") {
		cols = append(cols, "simple_name")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadSimpleRows selects tbl_simple rows matching conds and eagerly
// loads every relation the mask selects. extra names columns that must be in
// the SELECT regardless of the mask, which is how a parent load makes sure the
// join key comes back on its children.
func LoadSimpleRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*SimpleResult, error) {
	cols := SimpleQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_simple", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*SimpleResult
	for sqlRows.Next() {
		row := new(SimpleResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	return rows, nil
}

// LoadSimple selects tbl_simple rows, restricted to the fields named
// by mask. A nil or empty mask selects every column and loads no relations:
// eager loading is always opt-in, so the mask alone decides how deep a load
// goes.
func LoadSimple(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Simple, error) {
	rows, err := LoadSimpleRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Simple, len(rows))
	for i, row := range rows {
		out[i] = &row.Simple
	}
	return out, nil
}
