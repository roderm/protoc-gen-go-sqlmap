func init() {
	BookTable.ForeignKeys = append(BookTable.ForeignKeys, &v1.SchemaForeignKey{
		Columns: []*v1.SchemaColumn{
			BookColumnDef_AuthorId,
		},
		RefTable: AuthorTable,
		RefColumns: []*v1.SchemaColumn{
			AuthorColumnDef_Id,
		},
		OnDelete: v1.OnDelete_ON_DELETE_CASCADE.Enum(),
	})
	BookTable.ForeignKeys = append(BookTable.ForeignKeys, &v1.SchemaForeignKey{
		Columns: []*v1.SchemaColumn{
			BookColumnDef_Publisher,
		},
		RefTable: PublisherTable,
		RefColumns: []*v1.SchemaColumn{
			PublisherColumnDef_Id,
		},
		OnDelete: v1.OnDelete_ON_DELETE_UNSPECIFIED.Enum(),
	})
}

type PublisherResult struct {
	Publisher
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *PublisherResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "publisher_id":
			values[i] = &n.Id
		case "publisher_name":
			values[i] = &n.Name
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	return nil
}

func (n *Publisher) GetColValue(col string) any {
	switch col {
	case "publisher_id":
		return n.Id
	case "publisher_name":
		return n.Name
	default:
		return nil
	}
}

func GetPublisherPKColumns() []string {
	return []string{
		"publisher_id",
	}
}

func GetPublisherColumns() []string {
	return []string{
		"publisher_id",
		"publisher_name",
	}
}

