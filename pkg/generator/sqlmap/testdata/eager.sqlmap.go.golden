// LoadAuthorRows selects tbl_author rows matching conds and eagerly
// loads every relation the mask selects. extra forces columns into the SELECT
// regardless of the mask, which is how a parent gets the join key back.
func LoadAuthorRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*AuthorResult, error) {
	cols := AuthorQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_author", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*AuthorResult
	for sqlRows.Next() {
		row := new(AuthorResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	if m.HasRelation("books") {
		byKey := make(map[any][]*AuthorResult, len(rows))
		for _, row := range rows {
			key := query.Key(row.GetId())
			if key == nil {
				continue
			}
			byKey[key] = append(byKey[key], row)
		}
		if cond, ok := query.In("author_id", query.Keys(byKey)); ok {
			related, err := LoadBookRows(ctx, c, m.Sub("books"), []query.Cond{cond}, "author_id")
			if err != nil {
				return nil, err
			}
			for _, rel := range related {
				for _, row := range byKey[query.Key(rel.GetAuthorId())] {
					row.Books = append(row.Books, &rel.Book)
				}
			}
		}
	}

	return rows, nil
}

// LoadAuthor selects tbl_author rows restricted to the fields mask
// names. A nil or empty mask selects every column and loads no relations.
func LoadAuthor(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Author, error) {
	rows, err := LoadAuthorRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Author, len(rows))
	for i, row := range rows {
		out[i] = &row.Author
	}
	return out, nil
}

// BookQueryColumns returns the columns to select for mask. Primary keys
// are always included, since relations are stitched on them.
func BookQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 6+len(extra))
	cols = append(cols, "book_id")
	if m.Has("title") {
		cols = append(cols, "book_title")
	}
	if m.Has("author_id") {
		cols = append(cols, "author_id")
	}
	if m.Has("pages") {
		cols = append(cols, "pages")
	}
	if m.Has("published_at") {
		cols = append(cols, "published_at")
	}
	if m.Has("publisher") {
		cols = append(cols, "publisher_id")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadBookRows selects tbl_book rows matching conds and eagerly
// loads every relation the mask selects. extra forces columns into the SELECT
// regardless of the mask, which is how a parent gets the join key back.
func LoadBookRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*BookResult, error) {
	cols := BookQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_book", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*BookResult
	for sqlRows.Next() {
		row := new(BookResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	if m.HasRelation("publisher") {
		byKey := make(map[any][]*BookResult, len(rows))
		for _, row := range rows {
			key := query.Key(row.fk_publisher_id_id)
			if key == nil {
				continue
			}
			byKey[key] = append(byKey[key], row)
		}
		if cond, ok := query.In("publisher_id", query.Keys(byKey)); ok {
			related, err := LoadPublisherRows(ctx, c, m.Sub("publisher"), []query.Cond{cond})
			if err != nil {
				return nil, err
			}
			for _, rel := range related {
				for _, row := range byKey[query.Key(rel.GetId())] {
					row.Publisher = &rel.Publisher
				}
			}
		}
	}

	return rows, nil
}

// LoadBook selects tbl_book rows restricted to the fields mask
// names. A nil or empty mask selects every column and loads no relations.
func LoadBook(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Book, error) {
	rows, err := LoadBookRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Book, len(rows))
	for i, row := range rows {
		out[i] = &row.Book
	}
	return out, nil
}
