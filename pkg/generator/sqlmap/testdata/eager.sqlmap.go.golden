type BookResult struct {
	Book
	ts_published_at    sql.NullTime
	fk_publisher_id_id any
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *BookResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "book_id":
			values[i] = &n.Id
		case "book_title":
			values[i] = &n.Title
		case "author_id":
			values[i] = &n.AuthorId
		case "pages":
			values[i] = &n.Pages
		case "published_at":
			values[i] = &n.ts_published_at
		case "publisher_id":
			values[i] = &n.fk_publisher_id_id
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	// Left nil when the column is NULL, so an absent timestamp stays absent
	// rather than becoming the zero instant.
	if n.ts_published_at.Valid {
		n.PublishedAt = timestamppb.New(n.ts_published_at.Time)
	}
	return nil
}

func (n *Book) GetColValue(col string) any {
	switch col {
	case "book_id":
		return n.Id
	case "book_title":
		return n.Title
	case "author_id":
		return n.AuthorId
	case "pages":
		return n.Pages
	case "published_at":
		// Handed back as a time.Time, which is what a driver can bind.
		if n.PublishedAt == nil {
			return nil
		}
		return n.PublishedAt.AsTime()
	case "publisher_id":
		return n.Publisher
	default:
		return nil
	}
}

func GetBookPKColumns() []string {
	return []string{
		"book_id",
	}
}

func GetBookColumns() []string {
	return []string{
		"book_id",
		"book_title",
		"author_id",
		"pages",
		"published_at",
		"publisher_id",
	}
}

// PublisherQueryColumns returns the columns to select for mask. Primary keys
// are always included, since relations are stitched on them.
func PublisherQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 2+len(extra))
	cols = append(cols, "publisher_id")
	if m.Has("name") {
		cols = append(cols, "publisher_name")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadPublisherRows selects tbl_publisher rows matching conds and eagerly
// loads every relation the mask selects. extra forces columns into the SELECT
// regardless of the mask, which is how a parent gets the join key back.
func LoadPublisherRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*PublisherResult, error) {
	cols := PublisherQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_publisher", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*PublisherResult
	for sqlRows.Next() {
		row := new(PublisherResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	return rows, nil
}

// LoadPublisher selects tbl_publisher rows restricted to the fields mask
// names. A nil or empty mask selects every column and loads no relations.
func LoadPublisher(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Publisher, error) {
	rows, err := LoadPublisherRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Publisher, len(rows))
	for i, row := range rows {
		out[i] = &row.Publisher
	}
	return out, nil
}

