		Name: proto.String("kind"),
		Type: map[string]string{
			"mysql":    "VARCHAR(32)",
			"postgres": "VARCHAR(32)",
			"sqlite3":  "VARCHAR(32)",
		},
		Pk:       v1.PK_PK_UNSPECIFIED.Enum(),
		Nullable: proto.Bool(false),
	}
)
var IdentityTable = &v1.SchemaTable{
	Name: proto.String("identity"),
	Columns: []*v1.SchemaColumn{
		IdentityColumnDef_Id,
		IdentityDiscriminatorColumn,
	},
	Checks: []*v1.SchemaCheck{
		{
			Name: proto.String("identity_kind_check"),
			Expr: map[string]string{
				"mysql":    "`kind` IN ('person', 'org')",
				"postgres": "\"kind\" IN ('person', 'org')",
				"sqlite3":  "\"kind\" IN ('person', 'org')",
			},
		},
	},
	Indexes: []*v1.SchemaIndex{
		{
			Name:   proto.String("identity_kind_key"),
			Unique: proto.Bool(true),
			Columns: []*v1.SchemaColumn{
				IdentityColumnDef_Id,
				IdentityDiscriminatorColumn,
			},
		},
	},
}

func init() {
}

