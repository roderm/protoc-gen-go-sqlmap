type IdentityResult struct {
	Identity
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *IdentityResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "id":
			values[i] = &n.Id
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	return nil
}

func (n *Identity) GetColValue(col string) any {
	switch col {
	case "id":
		return n.Id
	default:
		return nil
	}
}

func GetIdentityPKColumns() []string {
	return []string{
		"id",
	}
}

func GetIdentityColumns() []string {
	return []string{
		"id",
	}
}

