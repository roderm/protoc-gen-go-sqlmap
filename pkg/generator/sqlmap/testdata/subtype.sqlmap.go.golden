func PersonQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 2+len(extra))
	cols = append(cols, "id")
	if m.Has("given_name") {
		cols = append(cols, "given_name")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

