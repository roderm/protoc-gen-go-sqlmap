package foreignkeypb

import (
	context "context"
	fmt "fmt"
	v1 "github.com/roderm/protoc-gen-go-sqlmap/pkg/generated/schema/v1"
	query "github.com/roderm/protoc-gen-go-sqlmap/pkg/query"
	proto "google.golang.org/protobuf/proto"
	fieldmaskpb "google.golang.org/protobuf/types/known/fieldmaskpb"
)

var (
	ParentColumnDef_Id = &v1.SchemaColumn{
		Name: proto.String("Id"),
		Type: map[string]string{
			"mysql":    "VARCHAR(255)",
			"postgres": "VARCHAR(255)",
			"sqlite3":  "VARCHAR(255)",
		},
		Pk:       v1.PK_PK_AUTO.Enum(),
		Nullable: proto.Bool(false),
	}
)
var ParentTable = &v1.SchemaTable{
	Name: proto.String("tbl_parent"),
	Columns: []*v1.SchemaColumn{
		ParentColumnDef_Id,
	},
}

func init() {
}

var (
	ChildColumnDef_Id = &v1.SchemaColumn{
		Name: proto.String("Id"),
		Type: map[string]string{
			"mysql":    "VARCHAR(255)",
			"postgres": "VARCHAR(255)",
			"sqlite3":  "VARCHAR(255)",
		},
		Pk:       v1.PK_PK_AUTO.Enum(),
		Nullable: proto.Bool(false),
	}
	ChildColumnDef_Parent = &v1.SchemaColumn{
		Name: proto.String("parent_id"),
		Type: map[string]string{
			"mysql":    "VARCHAR(255)",
			"postgres": "VARCHAR(255)",
			"sqlite3":  "VARCHAR(255)",
		},
		Pk:       v1.PK_PK_UNSPECIFIED.Enum(),
		Nullable: proto.Bool(true),
	}
)
var ChildTable = &v1.SchemaTable{
	Name: proto.String("tbl_child"),
	Columns: []*v1.SchemaColumn{
		ChildColumnDef_Id,
		ChildColumnDef_Parent,
	},
}

func init() {
	ChildTable.ForeignKeys = append(ChildTable.ForeignKeys, &v1.SchemaForeignKey{
		Columns: []*v1.SchemaColumn{
			ChildColumnDef_Parent,
		},
		RefTable: ParentTable,
		RefColumns: []*v1.SchemaColumn{
			ParentColumnDef_Id,
		},
		OnDelete: v1.OnDelete_ON_DELETE_UNSPECIFIED.Enum(),
	})
}

type ParentResult struct {
	Parent
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *ParentResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "Id":
			values[i] = &n.Id
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	return nil
}

func (n *Parent) GetColValue(col string) any {
	switch col {
	case "Id":
		return n.Id
	default:
		return nil
	}
}

func GetParentPKColumns() []string {
	return []string{
		"Id",
	}
}

func GetParentColumns() []string {
	return []string{
		"Id",
	}
}

type ChildResult struct {
	Child
	fk_parent_id_id any
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *ChildResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "Id":
			values[i] = &n.Id
		case "parent_id":
			values[i] = &n.fk_parent_id_id
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	if err := r.Scan(values...); err != nil {
		return err
	}
	return nil
}

func (n *Child) GetColValue(col string) any {
	switch col {
	case "Id":
		return n.Id
	case "parent_id":
		return n.Parent
	default:
		return nil
	}
}

func GetChildPKColumns() []string {
	return []string{
		"Id",
	}
}

func GetChildColumns() []string {
	return []string{
		"Id",
		"parent_id",
	}
}

// ParentQueryColumns returns the columns to select for mask. Primary keys
// are always included: they are what relations are stitched on, so leaving
// them out of the mask must not break eager loading.
func ParentQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 1+len(extra))
	cols = append(cols, "Id")
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadParentRows selects tbl_parent rows matching conds and eagerly
// loads every relation the mask selects. extra names columns that must be in
// the SELECT regardless of the mask, which is how a parent load makes sure the
// join key comes back on its children.
func LoadParentRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*ParentResult, error) {
	cols := ParentQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_parent", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*ParentResult
	for sqlRows.Next() {
		row := new(ParentResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	return rows, nil
}

// LoadParent selects tbl_parent rows, restricted to the fields named
// by mask. A nil or empty mask selects every column and loads no relations:
// eager loading is always opt-in, so the mask alone decides how deep a load
// goes.
func LoadParent(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Parent, error) {
	rows, err := LoadParentRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Parent, len(rows))
	for i, row := range rows {
		out[i] = &row.Parent
	}
	return out, nil
}

// ChildQueryColumns returns the columns to select for mask. Primary keys
// are always included: they are what relations are stitched on, so leaving
// them out of the mask must not break eager loading.
func ChildQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 2+len(extra))
	cols = append(cols, "Id")
	if m.Has("parent") {
		cols = append(cols, "parent_id")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadChildRows selects tbl_child rows matching conds and eagerly
// loads every relation the mask selects. extra names columns that must be in
// the SELECT regardless of the mask, which is how a parent load makes sure the
// join key comes back on its children.
func LoadChildRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*ChildResult, error) {
	cols := ChildQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_child", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*ChildResult
	for sqlRows.Next() {
		row := new(ChildResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	if m.HasRelation("parent") {
		byKey := make(map[any][]*ChildResult, len(rows))
		for _, row := range rows {
			key := query.Key(row.fk_parent_id_id)
			if key == nil {
				continue
			}
			byKey[key] = append(byKey[key], row)
		}
		if cond, ok := query.In("Id", query.Keys(byKey)); ok {
			related, err := LoadParentRows(ctx, c, m.Sub("parent"), []query.Cond{cond})
			if err != nil {
				return nil, err
			}
			for _, rel := range related {
				for _, row := range byKey[query.Key(rel.GetId())] {
					row.Parent = &rel.Parent
				}
			}
		}
	}

	return rows, nil
}

// LoadChild selects tbl_child rows, restricted to the fields named
// by mask. A nil or empty mask selects every column and loads no relations:
// eager loading is always opt-in, so the mask alone decides how deep a load
// goes.
func LoadChild(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Child, error) {
	rows, err := LoadChildRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Child, len(rows))
	for i, row := range rows {
		out[i] = &row.Child
	}
	return out, nil
}
