}

// LoadBook selects tbl_book rows, restricted to the fields named
// by mask. A nil or empty mask selects every column and loads no relations:
// eager loading is always opt-in, so the mask alone decides how deep a load
// goes.
func LoadBook(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Book, error) {
	rows, err := LoadBookRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
