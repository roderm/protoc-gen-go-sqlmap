func init() {
	BookTable.ForeignKeys = append(BookTable.ForeignKeys, &v1.SchemaForeignKey{
		Columns: []*v1.SchemaColumn{
			BookColumnDef_AuthorId,
		},
		RefTable: AuthorTable,
		RefColumns: []*v1.SchemaColumn{
			AuthorColumnDef_Id,
		},
		OnDelete: v1.OnDelete_ON_DELETE_SET_NULL.Enum(),
	})
}

type AuthorResult struct {
	Author
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *AuthorResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "author_id":
			values[i] = &n.Id
		case "author_name":
			values[i] = &n.Name
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	return r.Scan(values...)
}

func (n *Author) GetColValue(col string) any {
	switch col {
	case "author_id":
		return n.Id
	case "author_name":
		return n.Name
	default:
		return nil
	}
}

func GetAuthorPKColumns() []string {
	return []string{
		"author_id",
	}
}

func GetAuthorColumns() []string {
	return []string{
		"author_id",
		"author_name",
	}
}

type BookResult struct {
	Book
}

// Scan reads cols off r, which is satisfied by both *sql.Row and *sql.Rows.
func (n *BookResult) Scan(cols []string, r interface{ Scan(dest ...any) error }) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "book_id":
			values[i] = &n.Id
		case "book_title":
			values[i] = &n.Title
		case "author_id":
			values[i] = &n.AuthorId
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	return r.Scan(values...)
}

func (n *Book) GetColValue(col string) any {
	switch col {
	case "book_id":
		return n.Id
	case "book_title":
		return n.Title
	case "author_id":
		return n.AuthorId
	default:
		return nil
	}
}

func GetBookPKColumns() []string {
	return []string{
		"book_id",
	}
}

func GetBookColumns() []string {
	return []string{
		"book_id",
		"book_title",
		"author_id",
	}
}

// AuthorQueryColumns returns the columns to select for mask. Primary keys
// are always included: they are what relations are stitched on, so leaving
// them out of the mask must not break eager loading.
func AuthorQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 2+len(extra))
	cols = append(cols, "author_id")
	if m.Has("name") {
		cols = append(cols, "author_name")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

// LoadAuthorRows selects tbl_author rows matching conds and eagerly
// loads every relation the mask selects. extra names columns that must be in
// the SELECT regardless of the mask, which is how a parent load makes sure the
// join key comes back on its children.
func LoadAuthorRows(ctx context.Context, c query.Conn, m *query.Mask, conds []query.Cond, extra ...string) ([]*AuthorResult, error) {
	cols := AuthorQueryColumns(m, extra...)
	sqlRows, err := c.Select(ctx, "tbl_author", cols, conds)
	if err != nil {
		return nil, err
	}
	defer sqlRows.Close()

	var rows []*AuthorResult
	for sqlRows.Next() {
		row := new(AuthorResult)
		if err := row.Scan(cols, sqlRows); err != nil {
			return nil, err
		}
		rows = append(rows, row)
	}
	if err := sqlRows.Err(); err != nil {
		return nil, err
	}
	if len(rows) == 0 {
		return rows, nil
	}

	return rows, nil
}

// LoadAuthor selects tbl_author rows, restricted to the fields named
// by mask. A nil or empty mask selects every column and loads no relations:
// eager loading is always opt-in, so the mask alone decides how deep a load
// goes.
func LoadAuthor(ctx context.Context, c query.Conn, mask *fieldmaskpb.FieldMask, conds ...query.Cond) ([]*Author, error) {
	rows, err := LoadAuthorRows(ctx, c, query.FromFieldMask(mask), conds)
	if err != nil {
		return nil, err
	}
	out := make([]*Author, len(rows))
	for i, row := range rows {
		out[i] = &row.Author
	}
	return out, nil
}

// BookQueryColumns returns the columns to select for mask. Primary keys
// are always included: they are what relations are stitched on, so leaving
// them out of the mask must not break eager loading.
func BookQueryColumns(m *query.Mask, extra ...string) []string {
	cols := make([]string, 0, 3+len(extra))
	cols = append(cols, "book_id")
	if m.Has("title") {
		cols = append(cols, "book_title")
	}
	if m.Has("author_id") {
		cols = append(cols, "author_id")
	}
	for _, e := range extra {
		if !query.Contains(cols, e) {
			cols = append(cols, e)
		}
	}
	return cols
}

