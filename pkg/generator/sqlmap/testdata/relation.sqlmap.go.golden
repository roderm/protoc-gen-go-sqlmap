package relationpb

import (
	context "context"
	fmt "fmt"
	v1 "github.com/roderm/protoc-gen-go-sqlmap/pkg/generated/schema/v1"
	query "github.com/roderm/protoc-gen-go-sqlmap/pkg/query"
	proto "google.golang.org/protobuf/proto"
	fieldmaskpb "google.golang.org/protobuf/types/known/fieldmaskpb"
)

var (
	AuthorColumnDef_Id = &v1.SchemaColumn{
		Name: proto.String("author_id"),
		Type: map[string]string{
			"mysql":    "BIGINT",
			"postgres": "BIGINT",
			"sqlite3":  "INTEGER",
		},
		Pk:       v1.PK_PK_AUTO.Enum(),
		Nullable: proto.Bool(false),
	}
	AuthorColumnDef_Name = &v1.SchemaColumn{
		Name: proto.String("author_name"),
		Type: map[string]string{
			"mysql":    "VARCHAR(255)",
			"postgres": "VARCHAR(255)",
			"sqlite3":  "VARCHAR(255)",
		},
		Pk:       v1.PK_PK_UNSPECIFIED.Enum(),
		Nullable: proto.Bool(true),
	}
)
var AuthorTable = &v1.SchemaTable{
	Name: proto.String("tbl_author"),
	Columns: []*v1.SchemaColumn{
		AuthorColumnDef_Id,
		AuthorColumnDef_Name,
	},
}

func init() {
}

var (
	BookColumnDef_Id = &v1.SchemaColumn{
		Name: proto.String("book_id"),
		Type: map[string]string{
			"mysql":    "BIGINT",
			"postgres": "BIGINT",
			"sqlite3":  "INTEGER",
		},
		Pk:       v1.PK_PK_AUTO.Enum(),
		Nullable: proto.Bool(false),
	}
	BookColumnDef_Title = &v1.SchemaColumn{
		Name: proto.String("book_title"),
		Type: map[string]string{
			"mysql":    "VARCHAR(255)",
			"postgres": "VARCHAR(255)",
			"sqlite3":  "VARCHAR(255)",
		},
		Pk:       v1.PK_PK_UNSPECIFIED.Enum(),
		Nullable: proto.Bool(true),
	}
	BookColumnDef_AuthorId = &v1.SchemaColumn{
		Name: proto.String("author_id"),
		Type: map[string]string{
			"mysql":    "BIGINT",
			"postgres": "BIGINT",
			"sqlite3":  "INTEGER",
		},
		Pk:       v1.PK_PK_UNSPECIFIED.Enum(),
		Nullable: proto.Bool(true),
	}
)
var BookTable = &v1.SchemaTable{
	Name: proto.String("tbl_book"),
	Columns: []*v1.SchemaColumn{
		BookColumnDef_Id,
		BookColumnDef_Title,
