type AuthorResult struct {
	Author
}

func (n *AuthorResult) Scan(cols []string, r *sql.Row) error {
	values := make([]any, len(cols))
	for i, col := range cols {
		switch col {
		case "author_id":
			values[i] = &n.Id
		case "author_name":
			values[i] = &n.Name
		default:
			return fmt.Errorf("unknown column '%s'", col)
		}
	}
	return r.Scan(values...)
}

func (n *Author) GetColValue(col string) any {
	switch col {
	case "author_id":
		return n.Id
	case "author_name":
		return n.Name
	default:
		return nil
	}
}

func GetAuthorPKColumns() []string {
	return []string{
